<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GTFS, temps réel et V'Lille : données ouvertes Ilévia -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Réponses du widget en notification, calculées par un service court -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- « à proximité » : arrêts et stations V'Lille autour du téléphone -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Reconnaissance vocale et synthèse : les services installés sur le téléphone -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ChtiApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="Chtipasse"
        android:theme="@style/Theme.Chti">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Boutons du widget et raccourcis : écran invisible (écoute, autorisations), puis AnswerService -->
        <activity
            android:name=".AnswerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".AnswerService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- AppFunctions (Gemini et autres agents) : service généré par KSP depuis BaseChtiAppFunctionService -->
        <service
            android:name=".ChtiAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="chti_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

        <receiver
            android:name=".ChtiWidgetReceiver"
            android:exported="true"
            android:label="Chtipasse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chti_widget" />
        </receiver>
    </application>
</manifest>
