<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GTFS, temps réel et V'Lille : données ouvertes Ilévia -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dernière réponse gardée en notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- « à proximité » : arrêts et stations V'Lille autour du téléphone -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Reconnaissance vocale : le service de reconnaissance du système (Google) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ChtiApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="chtilevia"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boutons du widget : carte de réponse par-dessus l'écran d'accueil -->
        <activity
            android:name=".AnswerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".ChtiWidgetReceiver"
            android:exported="true"
            android:label="chtilevia">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chti_widget" />
        </receiver>
    </application>
</manifest>
