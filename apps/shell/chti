#!/bin/sh
# chti — prochains passages Ilévia (bus, tram, métro) et dispo V'Lille, en ligne de commande.
# Dépendances : curl, jq, unzip, python3 (bibliothèque standard uniquement).
set -eu

# Les CHTI_* permettent de pointer vers des fixtures (file://) et de figer l'heure dans les tests
GTFS_URL="${CHTI_GTFS_URL:-https://media.ilevia.fr/opendata/gtfs.zip}"
RT_URL="${CHTI_RT_URL:-https://proxy.transport.data.gouv.fr/resource/ilevia-lille-gtfs-rt}"
GBFS_URL="${CHTI_GBFS_URL:-https://media.ilevia.fr/opendata}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/chtilevia"
FAVORITES="${XDG_CONFIG_HOME:-$HOME/.config}/chtilevia/favoris"
GTFS_MAX_AGE_MIN=1440
GTFS_RETRY_MIN=60

usage() {
	cat <<'EOF'
Usage :
  chti bus <ligne> [arrêt] [-d direction] [-n nombre]   ex : chti bus 10 gambetta -d flandres -n 5
  chti tram [arrêt] [-d direction] [-n nombre]          ex : chti tram croise laroche -d roubaix
  chti metro <1|2> [arrêt] [-d direction] [-n nombre]   ex : chti metro 1 republique -d chu   (théorique)
  chti velo <station> [--prendre|--deposer]             ex : chti velo rihour --prendre
  chti <favori>                                         ex : chti travail
  chti favoris                                          liste les favoris
  chti update                                           re-télécharge le référentiel GTFS
  chti --voix <commande>                                réponse en phrases, pour la synthèse vocale
  chti vocal "<phrase>"                                 ex : chti vocal "prochain tram à croisé laroche vers roubaix"

Sans arrêt, la liste des arrêts de la ligne est affichée.
-d / --direction / --vers : ne garde que les courses dont la destination contient ce texte.
  « vers » s'écrit aussi sans tiret : chti tram croise laroche vers roubaix
-n / --nombre : nombre de passages affichés par direction (3 par défaut).
--prendre / --deposer : n'affiche que les vélos disponibles / que les places libres.
La recherche ignore la casse et les accents.
EOF
}

# die <code> <message> : code stable (pour les machines), message en français (pour les humains)
die() {
	shift # le code ne sert qu'à la sortie JSON
	if [ "${CHTI_VOIX:-}" = 1 ]; then
		# Phrase à lire : majuscule initiale
		printf '%s\n' "$*" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }' >&2
	else
		printf 'chti : %s\n' "$*" >&2
	fi
	exit 1
}

need() {
	for cmd in "$@"; do
		command -v "$cmd" >/dev/null 2>&1 || die missing_dependency "commande requise introuvable : $cmd"
	done
}

fetch() {
	if [ "${CHTI_VOIX:-}" = 1 ]; then
		curl -fsL --max-time 30 -o "$2" "$1" # pas de message brut de curl à lire à voix haute
	else
		curl -fsSL --max-time 30 -o "$2" "$1"
	fi
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/chti.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

# Vrai si le fichier $1 existe et a moins de $2 minutes
fresh() {
	[ -f "$1" ] && [ -z "$(find "$1" -mmin +"$2" 2>/dev/null)" ]
}

# Télécharge le GTFS et reconstruit l'index si absent, trop vieux ou si $1 = force.
gtfs_refresh() {
	if [ "${1:-}" != force ] && [ -f "$CACHE/gtfs/stamp" ]; then
		fresh "$CACHE/gtfs/stamp" "$GTFS_MAX_AGE_MIN" && return 0
		# Cache périmé mais dernier essai raté récemment : on ne retente pas à chaque appel
		fresh "$CACHE/gtfs/retry" "$GTFS_RETRY_MIN" && return 0
	fi
	need unzip
	printf 'Mise à jour du référentiel GTFS…\n' >&2
	if ! fetch "$GTFS_URL" "$TMP/gtfs.zip" || ! unzip -q -o "$TMP/gtfs.zip" -d "$TMP/gtfs"; then
		# Réseau KO : on garde l'ancien cache s'il existe
		[ -f "$CACHE/gtfs/stamp" ] || die gtfs_unavailable "téléchargement du GTFS impossible ($GTFS_URL)"
		printf 'chti : GTFS non mis à jour, utilisation du cache existant\n' >&2
		touch "$CACHE/gtfs/retry"
		return 0
	fi
	run_py index "$TMP/gtfs"
	mkdir -p "$CACHE"
	rm -rf "$CACHE/gtfs.old"
	[ -d "$CACHE/gtfs" ] && mv "$CACHE/gtfs" "$CACHE/gtfs.old"
	mv "$TMP/gtfs" "$CACHE/gtfs"
	rm -rf "$CACHE/gtfs.old"
	touch "$CACHE/gtfs/stamp"
}

# Prochains passages : $1 = nom court de la ligne GTFS, $2 = recherche d'arrêt (optionnelle),
# $3 = recherche de direction (optionnelle), $4 = nombre de passages par direction
departures() {
	need python3
	gtfs_refresh
	rt=""
	case "$1" in
	M1 | M2) ;; # pas de temps réel métro en open data
	*)
		if fetch "$RT_URL" "$TMP/rt.pb"; then
			rt="$TMP/rt.pb"
		else
			[ "${CHTI_VOIX:-}" = 1 ] ||
				printf 'chti : flux temps réel indisponible, horaires théoriques uniquement\n' >&2
		fi
		;;
	esac
	run_py departures "$CACHE/gtfs" "$rt" "$1" "$2" "$3" "$4"
}

# V'Lille : $@ = mots du nom de station, avec --prendre (vélos seuls) ou --deposer (places seules)
velo() {
	need jq
	station=""
	mode=tout
	for word in "$@"; do
		case "$word" in
		--prendre) mode=prendre ;;
		--deposer | --déposer) mode=deposer ;;
		*) station="${station:+$station }$word" ;;
		esac
	done
	[ -n "$station" ] || die missing_station "précise un nom de station, ex : chti velo rihour"
	fetch "$GBFS_URL/station_information.json" "$TMP/info.json" || die bike_service_unreachable "V'Lille injoignable"
	fetch "$GBFS_URL/station_status.json" "$TMP/status.json" || die bike_service_unreachable "V'Lille injoignable"
	jq -r -n --arg q "$station" --arg mode "$mode" --arg voice "${CHTI_VOIX:-0}" --argjson clock "${CHTI_NOW:-null}" --slurpfile info "$TMP/info.json" --slurpfile status "$TMP/status.json" '
		def fold: ascii_downcase
			| gsub("[àâäÀÂÄ]"; "a") | gsub("[éèêëÉÈÊË]"; "e") | gsub("[îïÎÏ]"; "i")
			| gsub("[ôöÔÖ]"; "o") | gsub("[ùûüÙÛÜ]"; "u") | gsub("[çÇ]"; "c")
			| gsub("[^a-z0-9]+"; " ") | ltrimstr(" ") | rtrimstr(" ");
		($status[0].data.stations | map({key: .station_id, value: .}) | from_entries) as $st
		| ($q | fold) as $needle
		| [$info[0].data.stations[] | select(.name | fold | contains($needle))]
		| def bikes: if . == 0 then "aucun vélo disponible" elif . == 1 then "1 vélo disponible"
			else "\(.) vélos disponibles" end;
		  def docks: if . == 0 then "aucune place libre" elif . == 1 then "1 place libre"
			else "\(.) places libres" end;
		  if length == 0 then "Aucune station V'\''Lille ne correspond à « \($q) ».\n" | halt_error(1)
		  elif $voice == "1" then .[] | . as $i | ($st[$i.station_id] // {}) as $s
			| "\($i.name) : "
			+ (if ($s | length) == 0 then "statut indisponible"
			   elif $s.is_installed | not then "station hors service"
			   elif $mode == "prendre" then
				(if $s.is_renting then ($s.num_bikes_available | bikes) else "location impossible" end)
			   elif $mode == "deposer" then
				(if $s.is_returning then ($s.num_docks_available | docks) else "dépôt impossible" end)
			   elif $s.is_renting | not then "station hors service"
			   else ($s.num_bikes_available | bikes) + " et " + ($s.num_docks_available | docks)
			   end) + "."
		  else .[] | . as $i | ($st[$i.station_id] // {}) as $s
			| "\n  maj il y a \(((($clock // now) - ($s.last_reported // 0)) / 60 | floor)) min" as $age
			| "\($i.name)  (\($i.capacity) bornes)\n"
			+ (if ($s | length) == 0 then "  ⚠️  statut indisponible"
			   elif $s.is_installed | not then "  ⛔ station hors service"
			   elif $mode == "prendre" then
				(if $s.is_renting then "  🚲 \($s.num_bikes_available) vélo(s) dispo" + $age else "  ⛔ location impossible" end)
			   elif $mode == "deposer" then
				(if $s.is_returning then "  🅿️  \($s.num_docks_available) place(s) libre(s)" + $age else "  ⛔ dépôt impossible" end)
			   elif $s.is_renting | not then "  ⛔ station hors service"
			   else "  🚲 \($s.num_bikes_available) vélo(s) dispo   🅿️  \($s.num_docks_available) place(s) libre(s)"
				+ (if $s.is_returning then "" else "   ⚠️  dépôt impossible" end)
				+ $age
			   end) + "\n"
		  end'
}

# Commandes d'un favori, une par ligne (« nom: commande »), sans les commentaires
favorite_commands() {
	[ -f "$FAVORITES" ] || return 0
	sed -e 's/#.*//' "$FAVORITES" | awk -F: -v name="$1" '
		{ key = tolower($1); gsub(/^[ \t]+|[ \t]+$/, "", key) }
		key == tolower(name) && NF > 1 { sub(/^[^:]*:[ \t]*/, ""); sub(/[ \t]+$/, ""); if ($0 != "") print }'
}

favorites_list() {
	if [ ! -s "$FAVORITES" ]; then
		printf 'Aucun favori. Crée le fichier %s\n' "$FAVORITES"
		printf 'au format « nom: commande », ex : travail: tram croise laroche vers roubaix\n'
		return 0
	fi
	printf 'Favoris (%s) :\n' "$FAVORITES"
	sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e 's/^/  /' "$FAVORITES"
}

# Lance chaque commande du favori $1 ; renvoie 2 si le favori n'existe pas, 1 si une commande échoue
run_favorite() {
	cmds=$(favorite_commands "$1")
	[ -n "$cmds" ] || return 2
	status=0
	set -f # pas d'expansion de jokers dans les arguments
	while IFS= read -r line; do
		# shellcheck disable=SC2086 # découpage volontaire de la commande en arguments
		sh "$0" $line || status=1
	done <<FAV
$cmds
FAV
	set +f
	return "$status"
}

run_py() {
	python3 -I - "$@" <<'PY'
import csv, os, sys, time, unicodedata
from collections import defaultdict
from datetime import datetime, timedelta

try:
    from zoneinfo import ZoneInfo
    TZ = ZoneInfo("Europe/Paris")
except Exception:  # pas de base tz : heure locale de la machine
    TZ = None


VOICE = os.environ.get("CHTI_VOIX") == "1"


def bullet_list(title, items):
    # À l'écran : une puce par ligne ; à l'oral : une phrase
    if VOICE:
        return f". {title[:1].upper()}{title[1:]} : {', '.join(items)}."
    return f"\n{title} :\n" + "\n".join(f"  • {i}" for i in items)


def die(code, msg, hint=None):
    # code : identifiant stable (sortie JSON) ; hint = (titre, clé, éléments) : suggestions listées
    if hint:
        msg += bullet_list(hint[0], hint[2])
    print(msg[:1].upper() + msg[1:] if VOICE else f"chti : {msg}", file=sys.stderr)
    sys.exit(1)


def fold(s):
    # Minuscules, sans accents ni ponctuation, pour une recherche tolérante
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower()
    return " ".join("".join(c if c.isalnum() else " " for c in s).split())


def rows(path):
    with open(path, newline="", encoding="utf-8-sig") as f:
        yield from csv.DictReader(f)


def to_sec(hms):
    h, m, s = hms.split(":")
    return int(h) * 3600 + int(m) * 60 + int(s)


# --- Index : découpe stop_times.txt (53 Mo) en un petit fichier par ligne ---

def build_index(gtfs):
    route_of = {r["trip_id"]: r["route_id"] for r in rows(f"{gtfs}/trips.txt")}
    os.makedirs(f"{gtfs}/idx", exist_ok=True)
    out = {}
    try:
        for r in rows(f"{gtfs}/stop_times.txt"):
            route = route_of.get(r["trip_id"])
            if route is None:
                continue
            f = out.get(route)
            if f is None:
                f = out[route] = open(f"{gtfs}/idx/{route}.tsv", "w", encoding="utf-8")
            f.write(f'{r["trip_id"]}\t{r["stop_id"]}\t{r["stop_sequence"]}\t{r["departure_time"] or r["arrival_time"]}\n')
    finally:
        for f in out.values():
            f.close()


# --- Décodeur protobuf minimal pour GTFS-Realtime ---

def varint(b, i):
    r = s = 0
    while True:
        x = b[i]
        i += 1
        r |= (x & 0x7F) << s
        s += 7
        if x < 128:
            return r, i


def pb(b):
    # Renvoie {numéro de champ: [valeurs]} ; les champs length-delimited restent en bytes
    i, out = 0, defaultdict(list)
    while i < len(b):
        key, i = varint(b, i)
        field, wire = key >> 3, key & 7
        if wire == 0:
            v, i = varint(b, i)
        elif wire == 2:
            n, i = varint(b, i)
            v, i = b[i:i + n], i + n
        elif wire == 1:
            v, i = b[i:i + 8], i + 8
        elif wire == 5:
            v, i = b[i:i + 4], i + 4
        else:
            raise ValueError(f"wire type {wire} non géré")
        out[field].append(v)
    return out


def signed(v):
    return v - (1 << 64) if v >= 1 << 63 else v


def read_rt(path, trip_ids):
    """trip_id -> {"cancelled": bool, "stops": {stop_id: (time|None, delay|None)}, "last": stop_id}"""
    trips = {}
    feed = pb(open(path, "rb").read())
    for ent in feed[2]:
        for tu_raw in pb(ent)[3]:
            tu = pb(tu_raw)
            trip = pb(tu[1][0]) if tu[1] else {}
            tid = trip[1][0].decode() if trip.get(1) else ""
            if tid not in trip_ids:
                continue
            info = {"cancelled": trip.get(4, [0])[0] == 3, "stops": {}, "last": None}
            for stu_raw in tu[2]:
                stu = pb(stu_raw)
                if not stu.get(4) or stu.get(5, [0])[0] == 1:  # pas d'arrêt ou arrêt SKIPPED
                    continue
                sid = stu[4][0].decode()
                ev = pb((stu.get(3) or stu.get(2))[0]) if (stu.get(3) or stu.get(2)) else {}
                t = ev[2][0] if ev.get(2) else None
                d = signed(ev[1][0]) if ev.get(1) else None
                info["stops"][sid] = (t, d)
                info["last"] = sid
            trips[tid] = info
    return trips


# --- Prochains passages ---

def rt_times(stl, info, dates):
    """Horaires temps réel d'une course : le flux ne donne que les prochains arrêts,
    le dernier retard connu est donc propagé aux arrêts suivants (règle GTFS-RT).
    Les arrêts précédant la première mise à jour sont considérés comme déjà passés."""
    known = [(sec, info["stops"][sid]) for _, sid, sec in stl if sid in info["stops"]]
    if not known:
        return {}
    # Jour de service : celui qui colle le mieux au premier horaire temps réel
    sec0, (t0, d0) = known[0]
    base = min((midnight(d) for d in dates), key=lambda b: abs((t0 or b + sec0 + (d0 or 0)) - b - sec0))
    out, delay = {}, None
    for _, sid, sec in stl:
        theo = base + sec
        t, d = info["stops"].get(sid, (None, None))
        if t is None and d is not None:
            t = theo + d
        if t is not None:
            delay = t - theo
            out[sid] = t
        elif delay is not None:
            out[sid] = theo + delay
    return out


def service_dates(now):
    # La veille peut courir après minuit (horaires > 24:00:00) ; le lendemain sert
    # quand on demande plus de passages qu'il n'en reste ce soir
    today = now.date()
    return [today - timedelta(days=1), today, today + timedelta(days=1)]


def midnight(d):
    # Origine des horaires GTFS : « midi moins 12 h » du jour de service
    noon = datetime(d.year, d.month, d.day, 12, tzinfo=TZ)
    return noon.timestamp() - 12 * 3600


def departures(gtfs, rt_path, line, query, direction, count):
    count = int(count)
    route = next((r for r in rows(f"{gtfs}/routes.txt") if r["route_short_name"].upper() == line.upper()), None)
    if route is None:
        die("unknown_line", f"ligne inconnue : {line}")
    rid = route["route_id"]

    trips = {r["trip_id"]: r for r in rows(f"{gtfs}/trips.txt") if r["route_id"] == rid}
    all_trips = trips
    if direction:
        # Filtre sur la destination affichée (headsign) des courses
        wanted_dir = fold(direction)
        kept = {tid: t for tid, t in trips.items() if wanted_dir in fold(t["trip_headsign"])}
        if not kept:
            heads = sorted({t["trip_headsign"] for t in trips.values() if t["trip_headsign"]})
            die("unknown_direction",
                f"aucune direction de la ligne {route['route_short_name']} ne correspond à « {direction} »",
                ("directions possibles", "directions", heads))
        trips = kept
    stops = {r["stop_id"]: r for r in rows(f"{gtfs}/stops.txt")}
    sched = defaultdict(list)  # trip_id -> [(seq, stop_id, secondes)]
    with open(f"{gtfs}/idx/{rid}.tsv", encoding="utf-8") as f:
        for ln in f:
            tid, sid, seq, hms = ln.rstrip("\n").split("\t")
            sched[tid].append((int(seq), sid, to_sec(hms)))

    def area(sid):
        s = stops.get(sid, {})
        return s.get("parent_station") or sid

    def area_name(aid):
        return stops.get(aid, {}).get("stop_name", aid)

    if not query:
        if VOICE:
            die("missing_stop", f"Précise un arrêt, par exemple : {spoken_line(route).lower()} {area_name(area(next(iter(sched.values()))[0][1])).lower()}.")
        list_stops(route, trips, sched, area, area_name)
        return

    needle = fold(query)

    def match_stops(trip_ids):
        found = defaultdict(set)  # zone d'arrêt -> stop_ids desservis par ces courses
        for tid in trip_ids:
            for _, sid, _ in sched.get(tid, []):
                aid = area(sid)
                if needle in fold(area_name(aid)) or needle in fold(stops.get(sid, {}).get("stop_name", "")):
                    found[aid].add(sid)
        return found

    matched = match_stops(trips)  # seulement les courses retenues (filtre de direction)
    if not matched and direction:
        # L'arrêt existe peut-être, mais pas dans cette direction : le dire plutôt que « introuvable »
        elsewhere = match_stops(all_trips)
        if elsewhere:
            names = ", ".join(sorted({area_name(a) for a in elsewhere}))
            heads = sorted({t["trip_headsign"] for t in all_trips.values()
                            if t["trip_headsign"] and any(s in elsewhere for s in
                                                          {area(sid) for _, sid, _ in sched.get(t["trip_id"], [])})})
            die("stop_not_in_direction",
                f"l'arrêt {names} n'est pas desservi par la ligne {route['route_short_name']} "
                f"en direction de « {direction} »", ("directions qui le desservent", "directions", heads))
    if not matched:
        die("unknown_stop", f"aucun arrêt de la ligne {route['route_short_name']} ne correspond à « {query} » "
            "(relance sans arrêt pour voir la liste)")

    now = datetime.fromtimestamp(int(os.environ["CHTI_NOW"]), TZ) if os.environ.get("CHTI_NOW") else datetime.now(TZ)
    now_ts = now.timestamp()
    rt = read_rt(rt_path, trips.keys()) if rt_path else {}

    active = defaultdict(set)  # service_id -> dates actives (veille / jour J / lendemain)
    wanted = {d.strftime("%Y%m%d"): d for d in service_dates(now)}
    with open(f"{gtfs}/calendar_dates.txt", encoding="utf-8-sig") as f:
        for ln in f:
            parts = ln.rstrip("\r\n").split(",")
            if len(parts) == 3 and parts[1] in wanted and parts[2] == "1":
                active[parts[0]].add(wanted[parts[1]])

    all_sids = set().union(*matched.values())
    events = defaultdict(set)  # stop_id -> {(timestamp, destination, temps_réel)}
    for tid, trip in trips.items():
        stl = sorted(sched.get(tid, []))
        if not stl:
            continue
        dest = trip["trip_headsign"] or area_name(area(stl[-1][1]))
        info = rt.get(tid)
        if info is None:
            for d in active.get(trip["service_id"], ()):
                base = midnight(d)
                for _, sid, sec in stl:
                    if sid in all_sids:
                        events[sid].add((base + sec, dest, False))
            continue
        if info["cancelled"]:
            continue
        for sid, t in rt_times(stl, info, active.get(trip["service_id"]) or service_dates(now)).items():
            if sid in all_sids:
                events[sid].add((t, dest, True))

    for aid, sids in sorted(matched.items(), key=lambda kv: area_name(kv[0])):
        events_here = sorted(e for sid in sids for e in events[sid] if e[0] >= now_ts - 30)
        if VOICE:
            say_departures(route, area_name(aid), events_here, count, now_ts)
            continue
        s = stops.get(aid, {})
        print(f"\n{route['route_short_name']} — {area_name(aid)}  ({s.get('stop_desc', '').strip(' -')})")
        if not events_here:
            print("  aucun passage prévu")
            continue
        by_dest = defaultdict(list)
        for e in events_here:
            by_dest[e[1]].append(e)
        for dest, evs in sorted(by_dest.items(), key=lambda kv: kv[1][0][0]):
            print(f"  → {dest}")
            for t, _, live in evs[:count]:
                mins = round((t - now_ts) / 60)
                if mins <= 0:
                    when = "à l'approche"
                elif mins < 60:
                    when = f"dans {mins} min"
                else:
                    when = f"dans {mins // 60} h {mins % 60:02d}"
                hhmm = datetime.fromtimestamp(t, TZ).strftime("%H:%M")
                print(f"     {hhmm}  {when:<14} {'⏱  temps réel' if live else '🕒 théorique'}")


def spoken_line(route):
    name = route["route_short_name"]
    if route["route_type"] == "0":
        return "Tram"
    if route["route_type"] == "1":
        return f"Métro {name.lstrip('Mm')}"
    return f"Bus {name}"


def say_departures(route, stop_name, events, count, now_ts):
    # Une phrase par direction, sans emoji ni colonnes : pensée pour la synthèse vocale
    head = f"{spoken_line(route)}, arrêt {stop_name}"
    if not events:
        print(f"{head} : aucun passage prévu.")
        return
    by_dest = defaultdict(list)
    for e in events:
        by_dest[e[1]].append(e)
    for dest, evs in sorted(by_dest.items(), key=lambda kv: kv[1][0][0]):
        evs = evs[:count]
        all_planned = not any(live for _, _, live in evs)
        parts = []
        for t, _, live in evs:
            mins = round((t - now_ts) / 60)
            if mins <= 0:
                when = "à l'approche"
            elif mins < 60:
                when = f"dans {mins} minute{'s' if mins > 1 else ''}"
            else:
                dt = datetime.fromtimestamp(t, TZ)
                when = f"à {dt.hour} h {dt.minute:02d}" if dt.minute else f"à {dt.hour} h"
            if not live and not all_planned:
                when += " (prévu)"
            parts.append(when)
        tail = " Horaires théoriques." if all_planned else ""
        print(f"{head}, vers {dest} : {', puis '.join(parts)}.{tail}")


def list_stops(route, trips, sched, area, area_name):
    # Pour chaque sens, la course la plus longue donne l'ordre des arrêts
    best = {}
    for tid, trip in trips.items():
        d = trip["direction_id"]
        if tid in sched and len(sched[tid]) > len(sched.get(best.get(d), [])):
            best[d] = tid
    print(f"Ligne {route['route_short_name']} — {route['route_desc']}")
    for _, tid in sorted(best.items()):
        print(f"\n  Direction {trips[tid]['trip_headsign']} :")
        seen = []
        for _, sid, _ in sorted(sched[tid]):
            name = area_name(area(sid))
            if not seen or seen[-1] != name:
                seen.append(name)
                print(f"    • {name}")


# --- Phrase libre (reconnaissance vocale) -> arguments de chti ---

NUMBERS = {"un": "1", "une": "1", "deux": "2", "trois": "3", "quatre": "4", "cinq": "5", "six": "6",
           "sept": "7", "huit": "8", "neuf": "9", "dix": "10", "onze": "11", "douze": "12",
           "treize": "13", "quatorze": "14", "quinze": "15", "seize": "16", "dix sept": "17",
           "dix huit": "18", "dix neuf": "19", "vingt": "20"}
# Mots ignorés en tête de phrase et en tête du nom d'arrêt (jamais au milieu : « Pont de Bois »)
FILLERS = {"quand", "passe", "est", "ce", "que", "qu", "il", "y", "a", "le", "la", "les", "l", "au",
           "aux", "de", "du", "des", "d", "prochain", "prochains", "prochaine", "prochaines",
           "passage", "passages", "arret", "station", "horaire", "horaires", "je", "veux", "pour",
           "moi", "donne", "dis", "quel", "quels", "c", "le", "un"}
STOP_FILLERS = {"a", "au", "l", "arret", "station", "de", "du", "d"}
EXAMPLE = "Dis par exemple : métro 1 république vers chu, ou : vélo rihour."


def favorite_names(path):
    names = {}
    try:
        with open(path, encoding="utf-8") as f:
            for ln in f:
                key = ln.split("#", 1)[0].split(":", 1)[0].strip()
                if key and ":" in ln.split("#", 1)[0]:
                    names[spoken_key(key)] = key
    except OSError:
        pass
    return names


def spoken_key(text):
    # « Rentrer à vélo » et « rentrer-velo » donnent la même clé
    return " ".join(w for w in fold(text).split() if w not in FILLERS)


def strip_leading(words, fillers):
    while words and words[0] in fillers:
        words = words[1:]
    return words


def parse_phrase(fav_path, phrase):
    words = fold(phrase).split()
    if not words:
        die("empty_phrase", "Je n'ai rien entendu.")
    favorites = favorite_names(fav_path)
    # « vers » / « direction » / « en direction de » : le reste de la phrase est la direction
    direction = []
    for i, w in enumerate(words):
        if w in ("vers", "direction"):
            words, direction = words[:i], strip_leading(words[i + 1:], {"de", "d", "du", "la", "l"})
            if words and words[-1] == "en":
                words = words[:-1]
            break
    body = strip_leading(words, FILLERS)
    if not body:
        die("not_understood", f"Je n'ai pas compris « {phrase} ». {EXAMPLE}")
    if not direction and spoken_key(" ".join(body)) in favorites:
        return [favorites[spoken_key(" ".join(body))]]

    head, rest = body[0], body[1:]
    if head in ("bus", "ligne", "liane"):
        if not rest:
            die("missing_line", f"Quelle ligne ? {EXAMPLE}")
        line = NUMBERS.get(" ".join(rest[:2]), None)
        if line:
            rest = rest[2:]
        else:
            line, rest = NUMBERS.get(rest[0], rest[0]), rest[1:]
        if head == "liane" and line.isdigit():
            line = "L" + line
        args = ["bus", line.upper()]
    elif head in ("metro", "metros"):
        if not rest or NUMBERS.get(rest[0], rest[0]).lstrip("m") not in ("1", "2"):
            die("unknown_metro", "Quel métro ? Dis par exemple : métro 1 république.")
        args, rest = ["metro", NUMBERS.get(rest[0], rest[0]).lstrip("m")], rest[1:]
    elif head in ("tram", "tramway"):
        args = ["tram"]
    elif head in ("velo", "velos", "vlille") or body[:2] == ["v", "lille"]:
        rest = body[2:] if head == "v" else rest
        mode = []
        for verb, flag in (("prendre", "--prendre"), ("emprunter", "--prendre"),
                           ("deposer", "--deposer"), ("rendre", "--deposer"), ("poser", "--deposer")):
            if verb in rest:
                rest = [w for w in rest if w != verb]
                mode = [flag]
        rest = [w for w in rest if w not in ("pour", "un", "mon", "velo", "velos")]
        rest = strip_leading(rest, STOP_FILLERS)
        if not rest:
            die("missing_station", "Quelle station ? Dis par exemple : vélo rihour.")
        return ["velo", *rest, *mode]
    else:
        die("not_understood", f"Je n'ai pas compris « {phrase} ». {EXAMPLE}")

    stop = strip_leading(rest, STOP_FILLERS)
    if not stop:
        die("missing_stop", f"Quel arrêt ? Dis par exemple : {' '.join(args)} gambetta.")
    return [*args, *stop, *(["-d", " ".join(direction)] if direction else [])]


