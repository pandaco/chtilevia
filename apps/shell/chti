#!/bin/sh
# chti — prochains passages Ilévia (bus, tram, métro) et dispo V'Lille, en ligne de commande.
# Dépendances : curl, jq, unzip, python3 (bibliothèque standard uniquement).
set -eu

# Les CHTI_* permettent de pointer vers des fixtures (file://) et de figer l'heure dans les tests
GTFS_URL="${CHTI_GTFS_URL:-https://media.ilevia.fr/opendata/gtfs.zip}"
RT_URL="${CHTI_RT_URL:-https://proxy.transport.data.gouv.fr/resource/ilevia-lille-gtfs-rt}"
GBFS_URL="${CHTI_GBFS_URL:-https://media.ilevia.fr/opendata}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/chtilevia"
FAVORITES="${XDG_CONFIG_HOME:-$HOME/.config}/chtilevia/favoris"
GTFS_MAX_AGE_MIN=1440
GTFS_RETRY_MIN=60

usage() {
	cat <<'EOF'
Usage :
  chti bus <ligne> [arrêt] [-d direction] [-n nombre]   ex : chti bus 10 gambetta -d flandres -n 5
  chti tram [arrêt] [-d direction] [-n nombre]          ex : chti tram croise laroche -d roubaix
  chti metro <1|2> [arrêt] [-d direction] [-n nombre]   ex : chti metro 1 republique -d chu   (théorique)
  chti velo <station> [--prendre|--deposer]             ex : chti velo rihour --prendre
  chti autour <latitude> <longitude> [-n nombre]        ex : chti autour 50.6366 3.0630
  chti <favori>                                         ex : chti travail
  chti favoris                                          liste les favoris
  chti update                                           re-télécharge le référentiel GTFS
  chti --voix <commande>                                réponse en phrases, pour la synthèse vocale
  chti --json <commande>                                réponse JSON, pour les programmes (schéma : libs/contract/schema)
  chti vocal "<phrase>"                                 ex : chti vocal "prochain tram à croisé laroche vers roubaix"

Sans arrêt, la liste des arrêts de la ligne est affichée.
-d / --direction / --vers : ne garde que les courses dont la destination contient ce texte.
  « vers » s'écrit aussi sans tiret : chti tram croise laroche vers roubaix
-n / --nombre : nombre de passages affichés par direction (3 par défaut) ; avec autour, nombre
  d'arrêts et de stations V'Lille.
--prendre / --deposer : n'affiche que les vélos disponibles / que les places libres.
La recherche ignore la casse et les accents, et tolère les fautes (arrêts, directions).
EOF
}

# die <code> <message> : code stable (pour les machines), message en français (pour les humains)
die() {
	if [ "${CHTI_JSON:-}" = 1 ]; then
		# Sur stdout : la réponse reste un document JSON, même en cas d'erreur
		printf '{\n  "type": "error",\n  "code": %s,\n  "message": %s,\n  "details": {}\n}\n' \
			"$(json_string "$1")" "$(json_string "$2")"
		exit 1
	fi
	shift # le code ne sert qu'à la sortie JSON
	if [ "${CHTI_VOIX:-}" = 1 ]; then
		# Phrase à lire : majuscule initiale
		printf '%s\n' "$*" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }' >&2
	else
		printf 'chti : %s\n' "$*" >&2
	fi
	exit 1
}

# Chaîne JSON entre guillemets, sans dépendre de jq (die doit marcher même si jq manque)
json_string() {
	printf '%s' "$1" | awk 'BEGIN { ORS = "" }
		{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); if (NR > 1) print "\\n"; print }' | {
		printf '"'
		cat
		printf '"'
	}
}

need() {
	for cmd in "$@"; do
		command -v "$cmd" >/dev/null 2>&1 || die missing_dependency "commande requise introuvable : $cmd"
	done
}

fetch() {
	if [ "${CHTI_VOIX:-}" = 1 ]; then
		curl -fsL --max-time 30 -o "$2" "$1" # pas de message brut de curl à lire à voix haute
	else
		curl -fsSL --max-time 30 -o "$2" "$1"
	fi
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/chti.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

# Vrai si le fichier $1 existe et a moins de $2 minutes
fresh() {
	[ -f "$1" ] && [ -z "$(find "$1" -mmin +"$2" 2>/dev/null)" ]
}

# Télécharge le GTFS et reconstruit l'index si absent, trop vieux ou si $1 = force.
gtfs_refresh() {
	if [ "${1:-}" != force ] && [ -f "$CACHE/gtfs/stamp" ]; then
		fresh "$CACHE/gtfs/stamp" "$GTFS_MAX_AGE_MIN" && return 0
		# Cache périmé mais dernier essai raté récemment : on ne retente pas à chaque appel
		fresh "$CACHE/gtfs/retry" "$GTFS_RETRY_MIN" && return 0
	fi
	need unzip
	printf 'Mise à jour du référentiel GTFS…\n' >&2
	if ! fetch "$GTFS_URL" "$TMP/gtfs.zip" || ! unzip -q -o "$TMP/gtfs.zip" -d "$TMP/gtfs"; then
		# Réseau KO : on garde l'ancien cache s'il existe
		[ -f "$CACHE/gtfs/stamp" ] || die gtfs_unavailable "téléchargement du GTFS impossible ($GTFS_URL)"
		WARNINGS="${WARNINGS:+$WARNINGS,}gtfs_stale"
		[ "${CHTI_JSON:-}" = 1 ] || printf 'chti : GTFS non mis à jour, utilisation du cache existant\n' >&2
		touch "$CACHE/gtfs/retry"
		return 0
	fi
	run_py index "$TMP/gtfs"
	mkdir -p "$CACHE"
	rm -rf "$CACHE/gtfs.old"
	[ -d "$CACHE/gtfs" ] && mv "$CACHE/gtfs" "$CACHE/gtfs.old"
	mv "$TMP/gtfs" "$CACHE/gtfs"
	rm -rf "$CACHE/gtfs.old"
	touch "$CACHE/gtfs/stamp"
}

# Prochains passages : $1 = nom court de la ligne GTFS, $2 = recherche d'arrêt (optionnelle),
# $3 = recherche de direction (optionnelle), $4 = nombre de passages par direction
departures() {
	need python3
	gtfs_refresh
	rt=""
	case "$1" in
	M1 | M2) ;; # pas de temps réel métro en open data
	*)
		if fetch "$RT_URL" "$TMP/rt.pb"; then
			rt="$TMP/rt.pb"
		else
			WARNINGS="${WARNINGS:+$WARNINGS,}realtime_unavailable"
			[ "${CHTI_VOIX:-}" = 1 ] || [ "${CHTI_JSON:-}" = 1 ] ||
				printf 'chti : flux temps réel indisponible, horaires théoriques uniquement\n' >&2
		fi
		;;
	esac
	run_py departures "$CACHE/gtfs" "$rt" "$1" "$2" "$3" "$4" "${WARNINGS:-}"
}

# V'Lille : $@ = mots du nom de station, avec --prendre (vélos seuls) ou --deposer (places seules)
velo() {
	need jq
	station=""
	mode=tout
	for word in "$@"; do
		case "$word" in
		--prendre) mode=prendre ;;
		--deposer | --déposer) mode=deposer ;;
		*) station="${station:+$station }$word" ;;
		esac
	done
	[ -n "$station" ] || die missing_station "précise un nom de station, ex : chti velo rihour"
	fetch "$GBFS_URL/station_information.json" "$TMP/info.json" || die bike_service_unreachable "V'Lille injoignable"
	fetch "$GBFS_URL/station_status.json" "$TMP/status.json" || die bike_service_unreachable "V'Lille injoignable"
	if [ "${CHTI_JSON:-}" = 1 ]; then
		velo_json "$station" "$mode"
		return
	fi
	jq -r -n --arg q "$station" --arg mode "$mode" --arg voice "${CHTI_VOIX:-0}" --argjson clock "${CHTI_NOW:-null}" --slurpfile info "$TMP/info.json" --slurpfile status "$TMP/status.json" '
		def fold: ascii_downcase
			| gsub("[àâäÀÂÄ]"; "a") | gsub("[éèêëÉÈÊË]"; "e") | gsub("[îïÎÏ]"; "i")
			| gsub("[ôöÔÖ]"; "o") | gsub("[ùûüÙÛÜ]"; "u") | gsub("[çÇ]"; "c")
			| gsub("[^a-z0-9]+"; " ") | ltrimstr(" ") | rtrimstr(" ");
		($status[0].data.stations | map({key: .station_id, value: .}) | from_entries) as $st
		| ($q | fold) as $needle
		| [$info[0].data.stations[] | select(.name | fold | contains($needle))]
		| def bikes: if . == 0 then "aucun vélo disponible" elif . == 1 then "1 vélo disponible"
			else "\(.) vélos disponibles" end;
		  def docks: if . == 0 then "aucune place libre" elif . == 1 then "1 place libre"
			else "\(.) places libres" end;
		  if length == 0 then "Aucune station V'\''Lille ne correspond à « \($q) ».\n" | halt_error(1)
		  elif $voice == "1" then .[] | . as $i | ($st[$i.station_id] // {}) as $s
			| "\($i.name) : "
			+ (if ($s | length) == 0 then "statut indisponible"
			   elif $s.is_installed | not then "station hors service"
			   elif $mode == "prendre" then
				(if $s.is_renting then ($s.num_bikes_available | bikes) else "location impossible" end)
			   elif $mode == "deposer" then
				(if $s.is_returning then ($s.num_docks_available | docks) else "dépôt impossible" end)
			   elif $s.is_renting | not then "station hors service"
			   else ($s.num_bikes_available | bikes) + " et " + ($s.num_docks_available | docks)
			   end) + "."
		  else .[] | . as $i | ($st[$i.station_id] // {}) as $s
			| "\n  maj il y a \(((($clock // now) - ($s.last_reported // 0)) / 60 | floor)) min" as $age
			| "\($i.name)  (\($i.capacity) bornes)\n"
			+ (if ($s | length) == 0 then "  ⚠️  statut indisponible"
			   elif $s.is_installed | not then "  ⛔ station hors service"
			   elif $mode == "prendre" then
				(if $s.is_renting then "  🚲 \($s.num_bikes_available) vélo(s) dispo" + $age else "  ⛔ location impossible" end)
			   elif $mode == "deposer" then
				(if $s.is_returning then "  🅿️  \($s.num_docks_available) place(s) libre(s)" + $age else "  ⛔ dépôt impossible" end)
			   elif $s.is_renting | not then "  ⛔ station hors service"
			   else "  🚲 \($s.num_bikes_available) vélo(s) dispo   🅿️  \($s.num_docks_available) place(s) libre(s)"
				+ (if $s.is_returning then "" else "   ⚠️  dépôt impossible" end)
				+ $age
			   end) + "\n"
		  end'
}

# Version JSON de velo : faits bruts par station, l'interprétation (prendre / déposer) au client
velo_json() {
	jq -n --arg q "$1" --arg mode "$2" --argjson clock "${CHTI_NOW:-null}" \
		--slurpfile info "$TMP/info.json" --slurpfile status "$TMP/status.json" '
		def fold: ascii_downcase
			| gsub("[àâäÀÂÄ]"; "a") | gsub("[éèêëÉÈÊË]"; "e") | gsub("[îïÎÏ]"; "i")
			| gsub("[ôöÔÖ]"; "o") | gsub("[ùûüÙÛÜ]"; "u") | gsub("[çÇ]"; "c")
			| gsub("[^a-z0-9]+"; " ") | ltrimstr(" ") | rtrimstr(" ");
		($status[0].data.stations | map({key: .station_id, value: .}) | from_entries) as $st
		| ($q | fold) as $needle
		| [$info[0].data.stations[] | select(.name | fold | contains($needle))]
		| if length == 0 then
			{type: "error", code: "unknown_station",
			 message: "Aucune station V'\''Lille ne correspond à « \($q) ».", details: {}}
		  else
			{type: "bike_stations", query: $q,
			 mode: ({tout: "all", prendre: "take", deposer: "return"}[$mode]),
			 stations: map(. as $i | ($st[$i.station_id] // null) as $s
				| {id: $i.station_id, name: $i.name, capacity: $i.capacity,
				   status: (if $s == null then "unknown"
					elif ($s.is_installed | not) or (($s.is_renting or $s.is_returning) | not) then "out_of_service"
					else "ok" end),
				   bikes: $s.num_bikes_available, docks: $s.num_docks_available,
				   renting: $s.is_renting, returning: $s.is_returning,
				   last_reported: (if $s.last_reported then $s.last_reported | todate else null end),
				   age_minutes: (if $s.last_reported then ((($clock // now) - $s.last_reported) / 60 | floor) else null end)})}
		  end' >"$TMP/velo.json"
	cat "$TMP/velo.json"
	jq -e '.type != "error"' "$TMP/velo.json" >/dev/null || exit 1
}

# Commandes d'un favori, une par ligne (« nom: commande »), sans les commentaires
favorite_commands() {
	[ -f "$FAVORITES" ] || return 0
	sed -e 's/#.*//' "$FAVORITES" | awk -F: -v name="$1" '
		{ key = tolower($1); gsub(/^[ \t]+|[ \t]+$/, "", key) }
		key == tolower(name) && NF > 1 { sub(/^[^:]*:[ \t]*/, ""); sub(/[ \t]+$/, ""); if ($0 != "") print }'
}

# Autour d'une position : $@ = latitude longitude [-n nombre]
autour() {
	need python3
	# En JSON, l'erreur est écrite sur stdout : la rendre telle quelle
	position=$(run_py position "$@") || {
		[ -z "$position" ] || printf '%s\n' "$position"
		exit 1
	}
	set -f
	# shellcheck disable=SC2086 # « lat lon nombre », validés par parse_position
	set -- $position
	set +f
	gtfs_refresh
	info="$TMP/info.json"
	status="$TMP/status.json"
	if ! fetch "$GBFS_URL/station_information.json" "$info" || ! fetch "$GBFS_URL/station_status.json" "$status"; then
		info=""
		status=""
		WARNINGS="${WARNINGS:+$WARNINGS,}bike_share_unavailable"
		[ "${CHTI_VOIX:-}" = 1 ] || [ "${CHTI_JSON:-}" = 1 ] ||
			printf "chti : V'Lille injoignable, stations non affichées\n" >&2
	fi
	run_py nearby "$CACHE/gtfs" "$info" "$status" "$1" "$2" "$3" "${WARNINGS:-}"
}

favorites_list() {
	if [ "${CHTI_JSON:-}" = 1 ]; then
		# Une entrée par favori (premier nom rencontré), avec toutes ses commandes
		{ [ -f "$FAVORITES" ] && sed -e 's/#.*//' "$FAVORITES" || :; } | jq -R -n --arg path "$FAVORITES" '
			[inputs | select(test(":")) | capture("^\\s*(?<name>[^:]*?)\\s*:\\s*(?<cmd>.*?)\\s*$")
			 | select(.name != "" and .cmd != "")]
			| reduce .[] as $f ([]; (map(.name | ascii_downcase) | index($f.name | ascii_downcase)) as $i
				| if $i == null then . + [{name: $f.name, commands: [$f.cmd]}]
				  else .[$i].commands += [$f.cmd] end)
			| {type: "favorites", path: $path, favorites: .}'
		return 0
	fi
	if [ ! -s "$FAVORITES" ]; then
		printf 'Aucun favori. Crée le fichier %s\n' "$FAVORITES"
		printf 'au format « nom: commande », ex : travail: tram croise laroche vers roubaix\n'
		return 0
	fi
	printf 'Favoris (%s) :\n' "$FAVORITES"
	sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e 's/^/  /' "$FAVORITES"
}

# Lance chaque commande du favori $1 ; renvoie 2 si le favori n'existe pas, 1 si une commande échoue
run_favorite() {
	cmds=$(favorite_commands "$1")
	[ -n "$cmds" ] || return 2
	status=0
	i=0
	set -f # pas d'expansion de jokers dans les arguments
	while IFS= read -r line; do
		i=$((i + 1))
		if [ "${CHTI_JSON:-}" = 1 ]; then
			# Un document par commande, rassemblés ensuite dans la réponse du favori
			# shellcheck disable=SC2086 # découpage volontaire de la commande en arguments
			sh "$0" $line >"$TMP/fav.$i.json" || status=1
		else
			# shellcheck disable=SC2086 # découpage volontaire de la commande en arguments
			sh "$0" $line || status=1
		fi
	done <<FAV
$cmds
FAV
	set +f
	if [ "${CHTI_JSON:-}" = 1 ]; then
		n=1
		while [ "$n" -le "$i" ]; do
			cat "$TMP/fav.$n.json"
			n=$((n + 1))
		done | jq -s --arg name "$1" '{type: "favorite", name: $name, results: .}'
	fi
	return "$status"
}

run_py() {
	python3 -I - "$@" <<'PY'
import csv, json, math, os, re, sys, time, unicodedata
from collections import defaultdict
from datetime import datetime, timedelta

try:
    from zoneinfo import ZoneInfo
    TZ = ZoneInfo("Europe/Paris")
except Exception:  # pas de base tz : heure locale de la machine
    TZ = None


VOICE = os.environ.get("CHTI_VOIX") == "1"
JSON = os.environ.get("CHTI_JSON") == "1"
WARNING_MESSAGES = {
    "realtime_unavailable": "flux temps réel indisponible, horaires théoriques uniquement",
    "gtfs_stale": "GTFS non mis à jour, utilisation du cache existant",
    "bike_share_unavailable": "V'Lille injoignable, stations non affichées",
}


def emit(doc):
    print(json.dumps(doc, ensure_ascii=False, indent=2))


def bullet_list(title, items):
    # À l'écran : une puce par ligne ; à l'oral : une phrase
    if VOICE:
        return f". {title[:1].upper()}{title[1:]} : {', '.join(items)}."
    return f"\n{title} :\n" + "\n".join(f"  • {i}" for i in items)


def die(code, msg, hint=None):
    # code : identifiant stable (sortie JSON) ; hint = (titre, clé, éléments) : suggestions listées
    if JSON:
        emit({"type": "error", "code": code, "message": msg, "details": {hint[1]: hint[2]} if hint else {}})
        sys.exit(1)
    if hint:
        msg += bullet_list(hint[0], hint[2])
    print(msg[:1].upper() + msg[1:] if VOICE else f"chti : {msg}", file=sys.stderr)
    sys.exit(1)


# Lettres sans décomposition Unicode, écrites en lettres simples avant de retirer les accents
LIGATURES = str.maketrans({"œ": "oe", "Œ": "OE", "æ": "ae", "Æ": "AE", "ø": "o", "Ø": "O", "ß": "ss", "ẞ": "SS"})


def fold(s):
    # Minuscules, sans accents ni ponctuation, pour une recherche tolérante
    s = unicodedata.normalize("NFKD", s.translate(LIGATURES)).encode("ascii", "ignore").decode().lower()
    return " ".join("".join(c if c.isalnum() else " " for c in s).split())


# --- Rapprochement approximatif (fautes de frappe, reconnaissance vocale) ---
# Règles appliquées dans l'ordre à chaque mot (forme fold) : phonétique française simple
SOUND_RULES = [(re.compile(a), b) for a, b in [
    ("eaux", "o"), ("eau", "o"), ("au", "o"), ("ph", "f"), ("ch", "sh"), ("qu", "k"), ("ck", "k"),
    ("c(?=[eiy])", "s"), ("c", "k"), ("gu(?=[eiy])", "g"), ("ai", "e"), ("ei", "e"), ("y", "i"),
    ("(?<![cs])h", ""), (r"(.)\1", r"\1"), ("(?<=.)er$", ""), ("(?<=.)[esxtdz]+$", ""),
]]


def sound(word):
    for pattern, repl in SOUND_RULES:
        word = pattern.sub(repl, word)
    return word


def edit_distance(a, b):
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def tolerance(word):
    return 0 if len(word) <= 3 else 1 if len(word) <= 7 else 2


def word_gap(query, name):
    # Écart entre deux suites de mots, ou None si trop éloignées :
    # - demande collée comparée à des mots consécutifs du nom collés (« croise la roche » ≈ « laroche ») ;
    # - mot à mot : chaque mot de plus de 2 lettres de la demande ressemble à un mot du nom.
    gaps = []
    joined = "".join(query)
    best = min(edit_distance(joined, "".join(name[i:j]))
               for i in range(len(name)) for j in range(i + 1, len(name) + 1))
    if best <= tolerance(joined):
        gaps.append(best)
    words = [w for w in query if len(w) > 2]
    if words:
        per_word = [min(edit_distance(w, n) for n in name) for w in words]
        if all(g <= tolerance(w) for g, w in zip(per_word, words)):
            gaps.append(sum(per_word))
    return min(gaps) if gaps else None


def approx_gap(query, name):
    # Écart entre une demande et un nom, à l'écrit (fold) ou au son ; None si sans rapport
    q, n = fold(query).split(), fold(name).split()
    if not q or not n:
        return None
    gaps = [g for g in (word_gap(q, n), word_gap([sound(w) for w in q], [sound(w) for w in n])) if g is not None]
    return min(gaps) if gaps else None


def closest(query, names):
    # Noms les plus proches de la demande (tous ceux à égalité), liste vide si aucun ne ressemble
    gaps = {n: approx_gap(query, n) for n in names}
    gaps = {n: g for n, g in gaps.items() if g is not None}
    return [n for n, g in gaps.items() if g == min(gaps.values())] if gaps else []


def rows(path):
    with open(path, newline="", encoding="utf-8-sig") as f:
        yield from csv.DictReader(f)


def to_sec(hms):
    h, m, s = hms.split(":")
    return int(h) * 3600 + int(m) * 60 + int(s)


# --- Index : découpe stop_times.txt (53 Mo) en un petit fichier par ligne ---

def build_index(gtfs):
    route_of = {r["trip_id"]: r["route_id"] for r in rows(f"{gtfs}/trips.txt")}
    os.makedirs(f"{gtfs}/idx", exist_ok=True)
    out = {}
    try:
        for r in rows(f"{gtfs}/stop_times.txt"):
            route = route_of.get(r["trip_id"])
            if route is None:
                continue
            f = out.get(route)
            if f is None:
                f = out[route] = open(f"{gtfs}/idx/{route}.tsv", "w", encoding="utf-8")
            f.write(f'{r["trip_id"]}\t{r["stop_id"]}\t{r["stop_sequence"]}\t{r["departure_time"] or r["arrival_time"]}\n')
    finally:
        for f in out.values():
            f.close()


# --- Décodeur protobuf minimal pour GTFS-Realtime ---

def varint(b, i):
    r = s = 0
    while True:
        x = b[i]
        i += 1
        r |= (x & 0x7F) << s
        s += 7
        if x < 128:
            return r, i


def pb(b):
    # Renvoie {numéro de champ: [valeurs]} ; les champs length-delimited restent en bytes
    i, out = 0, defaultdict(list)
    while i < len(b):
        key, i = varint(b, i)
        field, wire = key >> 3, key & 7
        if wire == 0:
            v, i = varint(b, i)
        elif wire == 2:
            n, i = varint(b, i)
            v, i = b[i:i + n], i + n
        elif wire == 1:
            v, i = b[i:i + 8], i + 8
        elif wire == 5:
            v, i = b[i:i + 4], i + 4
        else:
            raise ValueError(f"wire type {wire} non géré")
        out[field].append(v)
    return out


def signed(v):
    return v - (1 << 64) if v >= 1 << 63 else v


def read_rt(path, trip_ids):
    """trip_id -> {"cancelled": bool, "stops": {stop_id: (time|None, delay|None)}, "last": stop_id}"""
    trips = {}
    feed = pb(open(path, "rb").read())
    for ent in feed[2]:
        for tu_raw in pb(ent)[3]:
            tu = pb(tu_raw)
            trip = pb(tu[1][0]) if tu[1] else {}
            tid = trip[1][0].decode() if trip.get(1) else ""
            if tid not in trip_ids:
                continue
            info = {"cancelled": trip.get(4, [0])[0] == 3, "stops": {}, "last": None}
            for stu_raw in tu[2]:
                stu = pb(stu_raw)
                if not stu.get(4) or stu.get(5, [0])[0] == 1:  # pas d'arrêt ou arrêt SKIPPED
                    continue
                sid = stu[4][0].decode()
                ev = pb((stu.get(3) or stu.get(2))[0]) if (stu.get(3) or stu.get(2)) else {}
                t = ev[2][0] if ev.get(2) else None
                d = signed(ev[1][0]) if ev.get(1) else None
                info["stops"][sid] = (t, d)
                info["last"] = sid
            trips[tid] = info
    return trips


# --- Prochains passages ---

def rt_times(stl, info, dates):
    """Horaires temps réel d'une course : le flux ne donne que les prochains arrêts,
    le dernier retard connu est donc propagé aux arrêts suivants (règle GTFS-RT).
    Les arrêts précédant la première mise à jour sont considérés comme déjà passés."""
    known = [(sec, info["stops"][sid]) for _, sid, sec in stl if sid in info["stops"]]
    if not known:
        return {}
    # Jour de service : celui qui colle le mieux au premier horaire temps réel
    sec0, (t0, d0) = known[0]
    base = min((midnight(d) for d in dates), key=lambda b: abs((t0 or b + sec0 + (d0 or 0)) - b - sec0))
    out, delay = {}, None
    for _, sid, sec in stl:
        theo = base + sec
        t, d = info["stops"].get(sid, (None, None))
        if t is None and d is not None:
            t = theo + d
        if t is not None:
            delay = t - theo
            out[sid] = t
        elif delay is not None:
            out[sid] = theo + delay
    return out


def service_dates(now):
    # La veille peut courir après minuit (horaires > 24:00:00) ; le lendemain sert
    # quand on demande plus de passages qu'il n'en reste ce soir
    today = now.date()
    return [today - timedelta(days=1), today, today + timedelta(days=1)]


def midnight(d):
    # Origine des horaires GTFS : « midi moins 12 h » du jour de service
    noon = datetime(d.year, d.month, d.day, 12, tzinfo=TZ)
    return noon.timestamp() - 12 * 3600


def line_info(route):
    mode = {"0": "tram", "1": "metro"}.get(route["route_type"], "bus")
    return {"id": route["route_id"], "name": route["route_short_name"], "mode": mode,
            "label": spoken_line(route), "description": route["route_desc"]}


def iso(ts):
    return datetime.fromtimestamp(ts, TZ).isoformat(timespec="seconds")


def departures(gtfs, rt_path, line, query, direction, count, warnings=""):
    count = int(count)
    route = next((r for r in rows(f"{gtfs}/routes.txt") if r["route_short_name"].upper() == line.upper()), None)
    if route is None:
        die("unknown_line", f"ligne inconnue : {line}")
    rid = route["route_id"]

    trips = {r["trip_id"]: r for r in rows(f"{gtfs}/trips.txt") if r["route_id"] == rid}
    all_trips = trips
    if direction:
        # Filtre sur la destination affichée (headsign) des courses
        wanted_dir = fold(direction)
        kept = {tid: t for tid, t in trips.items() if wanted_dir in fold(t["trip_headsign"])}
        if not kept:
            # Sinon, les destinations qui ressemblent le plus à la demande
            near = set(closest(direction, {t["trip_headsign"] for t in trips.values() if t["trip_headsign"]}))
            kept = {tid: t for tid, t in trips.items() if t["trip_headsign"] in near}
        if not kept:
            heads = sorted({t["trip_headsign"] for t in trips.values() if t["trip_headsign"]})
            die("unknown_direction",
                f"aucune direction de la ligne {route['route_short_name']} ne correspond à « {direction} »",
                ("directions possibles", "directions", heads))
        trips = kept
    stops = {r["stop_id"]: r for r in rows(f"{gtfs}/stops.txt")}
    sched = defaultdict(list)  # trip_id -> [(seq, stop_id, secondes)]
    with open(f"{gtfs}/idx/{rid}.tsv", encoding="utf-8") as f:
        for ln in f:
            tid, sid, seq, hms = ln.rstrip("\n").split("\t")
            sched[tid].append((int(seq), sid, to_sec(hms)))

    def area(sid):
        s = stops.get(sid, {})
        return s.get("parent_station") or sid

    def area_name(aid):
        return stops.get(aid, {}).get("stop_name", aid)

    if not query:
        if VOICE:
            die("missing_stop", f"Précise un arrêt, par exemple : {spoken_line(route).lower()} {area_name(area(next(iter(sched.values()))[0][1])).lower()}.")
        list_stops(route, trips, sched, area, area_name)
        return

    needle = fold(query)

    def match_stops(trip_ids):
        found = defaultdict(set)  # zone d'arrêt -> stop_ids desservis par ces courses
        for tid in trip_ids:
            for _, sid, _ in sched.get(tid, []):
                aid = area(sid)
                if needle in fold(area_name(aid)) or needle in fold(stops.get(sid, {}).get("stop_name", "")):
                    found[aid].add(sid)
        return found

    def approx_stops(trip_ids):
        # Zones d'arrêt au nom (ou nom de quai) le plus proche de la demande, à égalité
        names = defaultdict(set)  # zone d'arrêt -> noms comparés
        served = defaultdict(set)  # zone d'arrêt -> stop_ids desservis par ces courses
        for tid in trip_ids:
            for _, sid, _ in sched.get(tid, []):
                aid = area(sid)
                names[aid] |= {area_name(aid), stops.get(sid, {}).get("stop_name", "")}
                served[aid].add(sid)
        gaps = {}
        for aid, ns in names.items():
            found = [g for g in (approx_gap(query, n) for n in ns) if g is not None]
            if found:
                gaps[aid] = min(found)
        return {aid: served[aid] for aid, g in gaps.items() if g == min(gaps.values())}

    def not_in_direction(elsewhere):
        # L'arrêt existe, mais pas dans cette direction : le dire plutôt que « introuvable »
        if elsewhere:
            names = ", ".join(sorted({area_name(a) for a in elsewhere}))
            heads = sorted({t["trip_headsign"] for t in all_trips.values()
                            if t["trip_headsign"] and any(s in elsewhere for s in
                                                          {area(sid) for _, sid, _ in sched.get(t["trip_id"], [])})})
            die("stop_not_in_direction",
                f"l'arrêt {names} n'est pas desservi par la ligne {route['route_short_name']} "
                f"en direction de « {direction} »", ("directions qui le desservent", "directions", heads))

    matched = match_stops(trips)  # seulement les courses retenues (filtre de direction)
    if not matched and direction:
        not_in_direction(match_stops(all_trips))
    if not matched:
        # Rien ne contient la demande : arrêts qui lui ressemblent (fautes, reconnaissance vocale)
        matched = approx_stops(trips)
        if not matched and direction:
            not_in_direction(approx_stops(all_trips))
        if len(matched) > 1:
            die("ambiguous_stop", f"plusieurs arrêts de la ligne {route['route_short_name']} ressemblent à « {query} »",
                ("arrêts approchants", "suggestions", sorted(area_name(a) for a in matched)))
    if not matched:
        die("unknown_stop", f"aucun arrêt de la ligne {route['route_short_name']} ne correspond à « {query} » "
            "(relance sans arrêt pour voir la liste)")

    now = datetime.fromtimestamp(int(os.environ["CHTI_NOW"]), TZ) if os.environ.get("CHTI_NOW") else datetime.now(TZ)
    now_ts = now.timestamp()
    rt = read_rt(rt_path, trips.keys()) if rt_path else {}

    active = defaultdict(set)  # service_id -> dates actives (veille / jour J / lendemain)
    wanted = {d.strftime("%Y%m%d"): d for d in service_dates(now)}
    with open(f"{gtfs}/calendar_dates.txt", encoding="utf-8-sig") as f:
        for ln in f:
            parts = ln.rstrip("\r\n").split(",")
            if len(parts) == 3 and parts[1] in wanted and parts[2] == "1":
                active[parts[0]].add(wanted[parts[1]])

    all_sids = set().union(*matched.values())
    events = defaultdict(set)  # stop_id -> {(timestamp, destination, temps_réel)}
    for tid, trip in trips.items():
        stl = sorted(sched.get(tid, []))
        if not stl:
            continue
        dest = trip["trip_headsign"] or area_name(area(stl[-1][1]))
        info = rt.get(tid)
        if info is None:
            for d in active.get(trip["service_id"], ()):
                base = midnight(d)
                for _, sid, sec in stl:
                    if sid in all_sids:
                        events[sid].add((base + sec, dest, False))
            continue
        if info["cancelled"]:
            continue
        for sid, t in rt_times(stl, info, active.get(trip["service_id"]) or service_dates(now)).items():
            if sid in all_sids:
                events[sid].add((t, dest, True))

    doc_stops = []
    for aid, sids in sorted(matched.items(), key=lambda kv: area_name(kv[0])):
        events_here = sorted(e for sid in sids for e in events[sid] if e[0] >= now_ts - 30)
        if JSON:
            by_dest = defaultdict(list)
            for e in events_here:
                by_dest[e[1]].append(e)
            doc_stops.append({
                "id": aid, "name": area_name(aid),
                "description": stops.get(aid, {}).get("stop_desc", "").strip(" -"),
                "directions": [{"headsign": dest, "departures": [
                    {"time": iso(t), "minutes": max(0, round((t - now_ts) / 60)), "realtime": live}
                    for t, _, live in evs[:count]]}
                    for dest, evs in sorted(by_dest.items(), key=lambda kv: kv[1][0][0])]})
            continue
        if VOICE:
            say_departures(route, area_name(aid), events_here, count, now_ts)
            continue
        s = stops.get(aid, {})
        print(f"\n{route['route_short_name']} — {area_name(aid)}  ({s.get('stop_desc', '').strip(' -')})")
        if not events_here:
            print("  aucun passage prévu")
            continue
        by_dest = defaultdict(list)
        for e in events_here:
            by_dest[e[1]].append(e)
        for dest, evs in sorted(by_dest.items(), key=lambda kv: kv[1][0][0]):
            print(f"  → {dest}")
            for t, _, live in evs[:count]:
                mins = round((t - now_ts) / 60)
                if mins <= 0:
                    when = "à l'approche"
                elif mins < 60:
                    when = f"dans {mins} min"
                else:
                    when = f"dans {mins // 60} h {mins % 60:02d}"
                hhmm = datetime.fromtimestamp(t, TZ).strftime("%H:%M")
                print(f"     {hhmm}  {when:<14} {'⏱  temps réel' if live else '🕒 théorique'}")
    if JSON:
        emit({"type": "departures", "line": line_info(route), "now": iso(now_ts), "stops": doc_stops,
              "warnings": [{"code": w, "message": WARNING_MESSAGES[w]} for w in warnings.split(",") if w]})


def spoken_line(route):
    name = route["route_short_name"]
    if route["route_type"] == "0":
        return "Tram"
    if route["route_type"] == "1":
        return f"Métro {name.lstrip('Mm')}"
    return f"Bus {name}"


def say_departures(route, stop_name, events, count, now_ts):
    # Une phrase par direction, sans emoji ni colonnes : pensée pour la synthèse vocale
    head = f"{spoken_line(route)}, arrêt {stop_name}"
    if not events:
        print(f"{head} : aucun passage prévu.")
        return
    by_dest = defaultdict(list)
    for e in events:
        by_dest[e[1]].append(e)
    for dest, evs in sorted(by_dest.items(), key=lambda kv: kv[1][0][0]):
        evs = evs[:count]
        all_planned = not any(live for _, _, live in evs)
        parts = []
        for t, _, live in evs:
            mins = round((t - now_ts) / 60)
            if mins <= 0:
                when = "à l'approche"
            elif mins < 60:
                when = f"dans {mins} minute{'s' if mins > 1 else ''}"
            else:
                dt = datetime.fromtimestamp(t, TZ)
                when = f"à {dt.hour} h {dt.minute:02d}" if dt.minute else f"à {dt.hour} h"
            if not live and not all_planned:
                when += " (prévu)"
            parts.append(when)
        tail = " Horaires théoriques." if all_planned else ""
        print(f"{head}, vers {dest} : {', puis '.join(parts)}.{tail}")


def list_stops(route, trips, sched, area, area_name):
    # Pour chaque sens, la course la plus longue donne l'ordre des arrêts
    best = {}
    for tid, trip in trips.items():
        d = trip["direction_id"]
        if tid in sched and len(sched[tid]) > len(sched.get(best.get(d), [])):
            best[d] = tid
    if JSON:
        directions = []
        for _, tid in sorted(best.items()):
            names = []
            for _, sid, _ in sorted(sched[tid]):
                name = area_name(area(sid))
                if not names or names[-1] != name:
                    names.append(name)
            directions.append({"headsign": trips[tid]["trip_headsign"], "stops": names})
        emit({"type": "stops", "line": line_info(route), "directions": directions})
        return
    print(f"Ligne {route['route_short_name']} — {route['route_desc']}")
    for _, tid in sorted(best.items()):
        print(f"\n  Direction {trips[tid]['trip_headsign']} :")
        seen = []
        for _, sid, _ in sorted(sched[tid]):
            name = area_name(area(sid))
            if not seen or seen[-1] != name:
                seen.append(name)
                print(f"    • {name}")


# --- Autour d'une position : arrêts desservis et stations V'Lille les plus proches ---

def parse_position(args):
    # Mots de la position et option -n, dans n'importe quel ordre ; écrit « lat lon nombre »
    count = "2" if VOICE else "3"
    words = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-n", "--nombre"):
            if i + 1 >= len(args):
                die("missing_option_value", f"option {arg} : précise un nombre, ex : {arg} 5")
            count = args[i + 1]
            i += 2
            continue
        if arg.startswith("--nombre="):
            count = arg.split("=", 1)[1]
        else:
            words.append(arg)
        i += 1
    if not re.fullmatch(r"[0-9]+", count) or count == "0":
        die("invalid_count", f"nombre de passages invalide : « {count} » (entier ≥ 1 attendu)")
    if not words:
        die("missing_position", "précise une position (latitude longitude), ex : chti autour 50.6366 3.0630")
    # « 50.6366,3.0630 » (un mot), « 50.6366, 3.0630 » ou « 50,6366 3,0630 » (deux mots)
    if len(words) == 1:
        parts = words[0].split(",")
    elif len(words) == 2:
        parts = [w.rstrip(",").replace(",", ".") for w in words]
    else:
        parts = []
    valid = len(parts) == 2 and all(re.fullmatch(r"-?[0-9]+(\.[0-9]+)?", p) for p in parts)
    if not valid or not (-90 <= float(parts[0]) <= 90 and -180 <= float(parts[1]) <= 180):
        die("invalid_position", f"position invalide : « {' '.join(words)} » "
            "(latitude et longitude en degrés décimaux, ex : 50.6366 3.0630)")
    print(parts[0], parts[1], int(count))


def distance_m(lat1, lon1, lat2, lon2):
    # Distance à vol d'oiseau (haversine), arrondie au mètre
    p1, p2 = lat1 * (math.pi / 180.0), lat2 * (math.pi / 180.0)
    dp, dl = p2 - p1, (lon2 - lon1) * (math.pi / 180.0)
    s1, s2 = math.sin(dp / 2), math.sin(dl / 2)
    a = s1 * s1 + math.cos(p1) * math.cos(p2) * s2 * s2
    return math.floor(2 * 6371000.0 * math.asin(math.sqrt(a)) + 0.5)


def spoken_distance(m, voice):
    if m < 1000:
        return f"{m} mètre{'s' if m > 1 else ''}" if voice else f"{m} m"
    tenths = math.floor(m / 100 + 0.5)
    km = f"{tenths // 10},{tenths % 10}" if tenths % 10 else f"{tenths // 10}"
    return f"{km} kilomètre{'s' if tenths >= 20 else ''}" if voice else f"{km} km"


def spoken_list(items):
    return items[0] if len(items) == 1 else ", ".join(items[:-1]) + " et " + items[-1]


def nearby(gtfs, info_path, status_path, lat, lon, count, warnings):
    lat, lon, count = float(lat), float(lon), int(count)
    routes = list(rows(f"{gtfs}/routes.txt"))
    stops = {r["stop_id"]: r for r in rows(f"{gtfs}/stops.txt")}
    members = defaultdict(set)  # zone d'arrêt -> elle-même et ses quais
    for sid, s in stops.items():
        members[s.get("parent_station") or sid].add(sid)
    zones = sorted(((distance_m(lat, lon, float(s["stop_lat"]), float(s["stop_lon"])), s["stop_name"], aid)
                    for aid, s in ((a, stops[a]) for a in members if a in stops)
                    if s.get("stop_lat") and s.get("stop_lon")))

    def lines_serving(stop_ids):
        # Lignes de chaque quai, lues dans l'index par ligne
        found = defaultdict(set)
        for route in routes:
            path = f"{gtfs}/idx/{route['route_id']}.tsv"
            if not os.path.exists(path):
                continue
            with open(path, encoding="utf-8") as f:
                for ln in f:
                    sid = ln.split("\t", 2)[1]
                    if sid in stop_ids:
                        found[sid].add(route["route_id"])
        return found

    # Zones les plus proches desservies par au moins une ligne, par lots
    near, start = [], 0
    while len(near) < count and start < len(zones):
        batch = zones[start:start + count * 4]
        start += len(batch)
        served = lines_serving(set().union(*(members[aid] for _, _, aid in batch)))
        for dist, _, aid in batch:
            ids = set().union(*(served.get(sid, set()) for sid in members[aid]))
            if ids and len(near) < count:
                near.append((dist, aid, [r for r in routes if r["route_id"] in ids]))

    stations = []
    if info_path:
        with open(info_path, encoding="utf-8") as f:
            info = json.load(f)["data"]["stations"]
        with open(status_path, encoding="utf-8") as f:
            status = {s["station_id"]: s for s in json.load(f)["data"]["stations"]}
        stations = sorted(((distance_m(lat, lon, st["lat"], st["lon"]), st["name"], st["station_id"], st) for st in info),
                          key=lambda t: t[:3])[:count]
    now = int(os.environ["CHTI_NOW"]) if os.environ.get("CHTI_NOW") else time.time()

    def station_state(st, voice):
        s = status.get(st["station_id"])
        if not s:
            return "statut indisponible"
        if not s.get("is_installed") or not s.get("is_renting"):
            return "station hors service"
        if voice:
            bikes = {0: "aucun vélo disponible", 1: "1 vélo disponible"}.get(s["num_bikes_available"],
                                                                         f"{s['num_bikes_available']} vélos disponibles")
            docks = {0: "aucune place libre", 1: "1 place libre"}.get(s["num_docks_available"],
                                                                   f"{s['num_docks_available']} places libres")
            return f"{bikes} et {docks}"
        return (f"🚲 {s['num_bikes_available']} vélo(s) dispo   🅿️  {s['num_docks_available']} place(s) libre(s)"
                + ("" if s.get("is_returning") else "   ⚠️  dépôt impossible"))

    if JSON:
        def station_doc(st, dist):
            s = status.get(st["station_id"])
            state = ("unknown" if s is None else "out_of_service"
                     if not s.get("is_installed") or not (s.get("is_renting") or s.get("is_returning")) else "ok")
            last = (s or {}).get("last_reported")
            return {"id": st["station_id"], "name": st["name"], "capacity": st.get("capacity"), "status": state,
                    "bikes": (s or {}).get("num_bikes_available"), "docks": (s or {}).get("num_docks_available"),
                    "renting": (s or {}).get("is_renting"), "returning": (s or {}).get("is_returning"),
                    "last_reported": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(last)) if last else None,
                    "age_minutes": math.floor((now - last) / 60) if last else None, "distance_m": dist}
        emit({"type": "nearby",
              "stops": [{"id": aid, "name": stops[aid]["stop_name"],
                         "description": stops[aid].get("stop_desc", "").strip(" -"), "distance_m": dist,
                         "lines": [line_info(r) for r in lines]} for dist, aid, lines in near],
              "bike_stations": [station_doc(st, dist) for dist, _, _, st in stations],
              "warnings": [{"code": w, "message": WARNING_MESSAGES[w]} for w in warnings.split(",") if w]})
        return
    if VOICE:
        if near:
            title = "Arrêt le plus proche" if len(near) == 1 else "Arrêts les plus proches"
            parts = [f"{stops[aid]['stop_name']}, à {spoken_distance(dist, True)}, "
                     f"{spoken_list([spoken_line(r) for r in lines])}" for dist, aid, lines in near]
            print(f"{title} : {' ; '.join(parts)}.")
        else:
            print("Aucun arrêt desservi à proximité.")
        if not info_path:
            print("V'Lille injoignable.")
        elif stations:
            title = "Station V'Lille la plus proche" if len(stations) == 1 else "Stations V'Lille les plus proches"
            parts = [f"{st['name']}, à {spoken_distance(dist, True)}, {station_state(st, True)}"
                     for dist, _, _, st in stations]
            print(f"{title} : {' ; '.join(parts)}.")
        return
    print("Arrêts proches :")
    if not near:
        print("  aucun arrêt desservi à proximité")
    for dist, aid, lines in near:
        s = stops[aid]
        print(f"  {s['stop_name']}  ({s.get('stop_desc', '').strip(' -')}) — {spoken_distance(dist, False)}")
        print(f"     {', '.join(spoken_line(r) for r in lines)}")
    if stations:
        print("\nStations V'Lille proches :")
        for dist, _, _, st in stations:
            print(f"  {st['name']}  ({st.get('capacity')} bornes) — {spoken_distance(dist, False)}")
            print(f"     {station_state(st, False)}")


