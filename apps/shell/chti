# --voix et --json peuvent se placer n'importe où : on les retire des arguments
for arg in "$@"; do
	shift
	case "$arg" in
	--voix) CHTI_VOIX=1 ;;
	--json) CHTI_JSON=1 ;;
	*) set -- "$@" "$arg" ;;
	esac
done
[ "${CHTI_VOIX:-}" = 1 ] && export CHTI_VOIX
[ "${CHTI_JSON:-}" = 1 ] && export CHTI_JSON
[ "${CHTI_VOIX:-}" = 1 ] && [ "${CHTI_JSON:-}" = 1 ] &&
	die unsupported_combination "--voix et --json ne peuvent pas être utilisés ensemble"

[ $# -ge 1 ] || {
	usage
	exit 1
}
cmd=$1
shift

# Sépare les mots de l'arrêt de l'option -d/--direction/--vers, placée n'importe où.
# Le mot « vers » seul fait passer les mots suivants dans la direction.
transit() {
	line=$1
	shift
	stop=""
	direction=""
	count=3
	[ "${CHTI_VOIX:-}" = 1 ] && count=2 # à l'oral, 2 passages suffisent
	after_vers=0
	while [ $# -gt 0 ]; do
		case "$1" in
		vers)
			after_vers=1
			shift
			;;
		-d | --direction | --vers)
			[ $# -ge 2 ] || die missing_option_value "option $1 : précise une direction, ex : $1 flandres"
			direction=$2
			shift 2
			;;
		--direction=* | --vers=*)
			direction=${1#*=}
			shift
			;;
		-n | --nombre)
			[ $# -ge 2 ] || die missing_option_value "option $1 : précise un nombre, ex : $1 5"
			count=$2
			shift 2
			;;
		--nombre=*)
			count=${1#*=}
			shift
			;;
		*)
			if [ "$after_vers" = 1 ]; then
				direction="${direction:+$direction }$1"
			else
				stop="${stop:+$stop }$1"
			fi
			shift
			;;
		esac
	done
	case "$count" in
	'' | *[!0-9]* | 0) die invalid_count "nombre de passages invalide : « $count » (entier ≥ 1 attendu)" ;;
	esac
	departures "$line" "$stop" "$direction" "$count"
}

case "$cmd" in
bus)
	[ $# -ge 1 ] || die missing_line "précise une ligne, ex : chti bus 10"
	transit "$@"
	;;
tram) transit TRAM "$@" ;;
metro | métro)
	case "${1:-}" in
	1 | m1 | M1) line=M1 ;;
	2 | m2 | M2) line=M2 ;;
	*) die unknown_metro "ligne de métro : 1 ou 2" ;;
	esac
	shift
	transit "$line" "$@"
	;;
velo | vélo | vlille) velo "$@" ;;
autour) autour "$@" ;;
update)
	need python3
	gtfs_refresh force
	if [ "${CHTI_JSON:-}" = 1 ]; then
		printf '{\n  "type": "update",\n  "path": %s\n}\n' "$(json_string "$CACHE/gtfs")"
	else
		printf 'Référentiel GTFS à jour dans %s\n' "$CACHE/gtfs"
	fi
	;;
favoris) favorites_list ;;
vocal)
	# Phrase reconnue à la voix -> commande chti, réponse en mode voix
	[ "${CHTI_JSON:-}" = 1 ] &&
		die unsupported_combination "vocal ne s'utilise pas avec --json : l'assistant interprète la phrase lui-même"
	CHTI_VOIX=1
	export CHTI_VOIX
	need python3
	parsed=$(run_py parse "$FAVORITES" "$*") || exit 1
	set -f
	set --
	while IFS= read -r arg; do
		set -- "$@" "$arg"
	done <<PARSED
$parsed
PARSED
	set +f
	exec sh "$0" "$@"
	;;
-h | --help | help) usage ;;
*)
	if [ $# -eq 0 ]; then
		status=0
		run_favorite "$cmd" || status=$?
		[ "$status" -eq 2 ] || exit "$status"
	fi
	[ "${CHTI_VOIX:-}" = 1 ] && die unknown_command "Je ne connais pas la commande ou le favori « $cmd »."
	[ "${CHTI_JSON:-}" = 1 ] && die unknown_command "commande ou favori inconnu : $cmd (voir chti favoris)"
	printf 'chti : commande ou favori inconnu : %s (voir chti favoris)\n\n' "$cmd" >&2
	usage >&2
	exit 1
	;;
esac
